APP_NAME="{{ project_name }}"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY={{ secret_key }}

DATABASE_URL=sqlite+aiosqlite:///./database.db
# Routes database.read_replica() to a replica instead of the primary --
# unset, read_replica() transparently falls back to the primary, so the
# code that uses it doesn't need to change either way. See
# docs/database.md#read-replicas.
# DATABASE_READ_URL=postgresql+asyncpg://user:pass@replica-host/app

# Plain human-readable log lines by default. "json" switches to one JSON
# object per line -- for a log shipper (Datadog, ELK, CloudWatch Logs
# Insights, Splunk) that parses structured fields instead of grepping
# text. See docs/observability.md.
# LOG_FORMAT=json

# Reports unhandled request exceptions, exhausted job retries, and raising
# scheduled tasks to Sentry. Requires `pip install zeython[sentry]` and
# app.register(ErrorMonitoringServiceProvider(app)) in main.py. See
# docs/error-monitoring.md.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Blanket per-IP rate limit across all routes (login/register are throttled
# separately either way -- see app/Controllers/auth_controller.py). Off by
# default; see docs/rate-limiting.md.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# "memory" runs jobs on a background task (see app/Jobs/); "sync" runs them
# immediately in-line -- useful for local debugging. "redis" is durable --
# a job survives a crash/restart -- but needs `zeython queue work` running
# as its own process to actually process jobs. See docs/queues.md.
QUEUE_DRIVER=memory
# QUEUE_DRIVER=redis
# REDIS_URL=redis://localhost:6379/0

# "log" writes emails to your app's logs instead of sending them -- works
# with zero setup. Switch to "smtp" and fill in the rest once you have real
# credentials. See docs/mail.md.
MAIL_DRIVER=log
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@{{ project_slug }}.example.com

# How many times the same query shape can run in one request before
# N1QueryDetectionServiceProvider warns about it (dev-only, requires
# APP_DEBUG=true). See docs/relationships.md#detecting-n1s-automatically.
# N1_QUERY_THRESHOLD=10
