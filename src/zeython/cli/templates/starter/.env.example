APP_NAME="{{ project_name }}"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY={{ secret_key }}

DATABASE_URL=sqlite+aiosqlite:///./database.db

# Plain human-readable log lines by default. "json" switches to one JSON
# object per line -- for a log shipper (Datadog, ELK, CloudWatch Logs
# Insights, Splunk) that parses structured fields instead of grepping
# text. See docs/observability.md.
# LOG_FORMAT=json

# Blanket per-IP rate limit across all routes (login/register are throttled
# separately either way -- see app/Controllers/auth_controller.py). Off by
# default; see docs/rate-limiting.md.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# "memory" runs jobs on a background task (see app/Jobs/); "sync" runs them
# immediately in-line -- useful for local debugging. "redis" is durable --
# a job survives a crash/restart -- but needs `zeython queue work` running
# as its own process to actually process jobs. See docs/queues.md.
QUEUE_DRIVER=memory
# QUEUE_DRIVER=redis
# REDIS_URL=redis://localhost:6379/0

# "log" writes emails to your app's logs instead of sending them -- works
# with zero setup. Switch to "smtp" and fill in the rest once you have real
# credentials. See docs/mail.md.
MAIL_DRIVER=log
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@{{ project_slug }}.example.com
